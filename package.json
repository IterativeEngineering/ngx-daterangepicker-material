{
  "name": "ngx-daterangepicker-material",
  "version": "21.0.0-extend-1",
  "description": "Angular 9 and 10 date range picker (with material design theme)",
  "keywords": [
    "angular2",
    "angular4",
    "angular5",
    "angular6",
    "angular7",
    "angular8",
    "angular9",
    "angular10",
    "angular11",
    "angular12",
    "angular13",
    "angular14",
    "angular15",
    "angular16",
    "ng2",
    "ngx",
    "daterangepicker",
    "material",
    "component",
    "directive",
    "daterange",
    "date",
    "dayjs",
    "picker"
  ],
  "homepage": "https://github.com/fetrarij/ngx-daterangepicker-material",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "ng": "ng",
    "ngc": "./node_modules/.bin/ngc -p tsconfig.json",
    "build": "ng-packagr -p ng-package.json -c tsconfig.json",
    "build:schematics": "tsc -p ./tsconfig.schematics.json",
    "copy:schematics": "cpr schematics/dist dist/schematics && cp ./schematics/collection.json ./dist/schematics && cp ./schematics/ng-add/schema.json ./dist/schematics/ng-add",
    "postbuild": "npm run build:schematics && npm run copy:schematics"
  },
  "author": "Fetrarijaona R.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fetrarij/ngx-daterangepicker-material.git"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "dayjs": "^1.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.23",
    "@angular-devkit/schematics": "^21.2.23",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.2.23",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@schematics/angular": "21.2.23",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "cpr": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^39.3.3",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.2.1",
    "ng-packagr": "^21.2.7",
    "prettier": "^2.7.1",
    "prettier-eslint": "^15.0.1",
    "rimraf": "^2.6.1",
    "rxjs": "^6.3.3",
    "ts-node": "~8.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "tslib": "^2.0.0"
  },
  "overrides": {
    "@angular-devkit/core": "21.2.23"
  },
  "schematics": "./schematics/collection.json"
}
